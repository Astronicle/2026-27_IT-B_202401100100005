# Copy to .env and fill in real values. Never commit .env.
DATABASE_URL=postgres://user:pass@localhost:5432/poryflux_db?sslmode=disable
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32
# MASTER_KEY must decode to exactly 32 bytes (hex 64 chars or base64).
# Generate with: openssl rand -hex 32
MASTER_KEY=change-me-32-byte-hex-key
PORT=8080
# Comma-separated browser origins allowed to call the API (CORS).
CORS_ORIGINS=http://localhost:3000
# Directory for encrypted file blobs. Use /app/storage inside Docker.
STORAGE_DIR=./storage
